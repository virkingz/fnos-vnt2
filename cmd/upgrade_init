#!/bin/bash
# 升级前：停掉运行中的进程，避免二进制被占用。
set -u

: "${TRIM_APPDEST:=/var/apps/vnt-nas/target}"
: "${TRIM_PKGVAR:=/var/apps/vnt-nas/var}"
: "${TRIM_PKGETC:=/var/apps/vnt-nas/etc}"
: "${TRIM_PKGTMP:=/var/apps/vnt-nas/tmp}"
: "${TRIM_TEMP_LOGFILE:=${TRIM_PKGTMP}/error.log}"
: "${TRIM_APPNAME:=vnt-nas}"

LIB="${TRIM_APPDEST}/shell/lib.sh"
[ -f "$LIB" ] || exit 0
# shellcheck disable=SC1090
. "$LIB"

vnt_paths
vnt_stop_core || true

# 停管理页后端
if vnt_shell_running; then
    pid="$(head -n 1 "$(vnt_shell_pid)" | tr -d '[:space:]')"
    kill -TERM "$pid" 2>/dev/null || true
    i=0
    while kill -0 "$pid" 2>/dev/null && [ $i -lt 15 ]; do sleep 1; i=$((i + 1)); done
    kill -KILL "$pid" 2>/dev/null || true
    rm -f "$(vnt_shell_pid)"
fi

exit 0
