#!/bin/bash
# 安装后：初始化目录、保存端口与访问令牌、尝试下载核心二进制。
# 核心下载失败不阻断安装（管理页可重试）。
# 注意：组网配置由 vnt2_web 网页自己管理，这里不生成。

: "${TRIM_APPDEST:=/var/apps/vnt-nas/target}"
: "${TRIM_PKGVAR:=/var/apps/vnt-nas/var}"
: "${TRIM_PKGETC:=/var/apps/vnt-nas/etc}"
: "${TRIM_PKGTMP:=/var/apps/vnt-nas/tmp}"
: "${TRIM_TEMP_LOGFILE:=${TRIM_PKGTMP}/error.log}"
: "${TRIM_APPNAME:=vnt-nas}"

LIB="${TRIM_APPDEST}/shell/lib.sh"
if [ ! -f "$LIB" ]; then
    echo "缺少组件: ${LIB}" > "${TRIM_TEMP_LOGFILE}" 2>/dev/null
    exit 1
fi
# shellcheck disable=SC1090
. "$LIB"

vnt_paths
vnt_ensure_dirs

# --- 端口：管理页端口 + 组网面板端口 ---
# 管理页端口：打开「VNT 组网」时访问的端口
: "${wizard_web_port:=${PANEL_PORT_DEFAULT}}"
case "${wizard_web_port}" in
'' | *[!0-9]*) wizard_web_port="${PANEL_PORT_DEFAULT}" ;;
esac
PANEL_PORT="${wizard_web_port}"

# 组网面板端口：vnt2_web 自己的端口，桌面的「VNT 组网面板」图标指向它
: "${wizard_panel_port:=${VNT_WEB_PORT_DEFAULT}}"
case "${wizard_panel_port}" in
'' | *[!0-9]*) wizard_panel_port="${VNT_WEB_PORT_DEFAULT}" ;;
esac
VNT_WEB_PORT="${wizard_panel_port}"

# 两个端口不能相同，否则会互相抢占
if [ "${PANEL_PORT}" = "${VNT_WEB_PORT}" ]; then
    vnt_log "install_callback: 两个端口相同，面板端口回退为默认 ${VNT_WEB_PORT_DEFAULT}"
    VNT_WEB_PORT="${VNT_WEB_PORT_DEFAULT}"
fi

# 端口范围兜底（向导已限制 1-65535，这里防止绕过向导直接传参）
vnt_port_ok() {
    case "$1" in
    '' | *[!0-9]*) return 1 ;;
    esac
    [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}
if ! vnt_port_ok "${PANEL_PORT}"; then
    vnt_log "install_callback: 管理页端口 ${PANEL_PORT} 非法，回退默认"
    PANEL_PORT="${PANEL_PORT_DEFAULT}"
fi
if ! vnt_port_ok "${VNT_WEB_PORT}"; then
    vnt_log "install_callback: 面板端口 ${VNT_WEB_PORT} 非法，回退默认"
    VNT_WEB_PORT="${VNT_WEB_PORT_DEFAULT}"
fi
if [ "${PANEL_PORT}" = "${VNT_WEB_PORT}" ]; then
    PANEL_PORT="${PANEL_PORT_DEFAULT}"
fi

vnt_save_ports

# --- 访问令牌：安装时自动生成，用户可稍后在管理页修改 ---
vnt_gen_token
vnt_log "install_callback: token generated ($(vnt_token_hint))"

# --- 核心不在此阶段下载 ---
# 安装只负责把壳装好；核心由用户在管理页点「检查更新 / 下载核心」获取。
# 这样安装过程不依赖外网，避免网络问题导致装不上。
chmod 0755 "$(vnt_bin_dir)" 2>/dev/null || true
vnt_log "install_callback: done. 核心待用户在管理页下载"

exit 0
